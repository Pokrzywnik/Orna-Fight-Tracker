<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ft_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.FT.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ft_overline_reference" />

            <TextView
                style="@style/TextAppearance.FT.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ft_codex_title" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/settingsButton"
            style="@style/Widget.FT.IconButton"
            android:contentDescription="@string/ft_settings"
            android:src="@drawable/ic_ft_settings" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/codexSegment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        app:checkedButton="@+id/btnAussie"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAussie"
            style="@style/Widget.FT.SegButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ft_codex_aussie" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnYaco"
            style="@style/Widget.FT.SegButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ft_codex_yaco" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/codexWebContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
