<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/runItemCard"
    style="@style/Widget.FT.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/runItemRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- type tag, name, duration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/runType"
                style="@style/TextAppearance.FT.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag"
                android:letterSpacing="0.06"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:textColor="@color/ft_accent"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/runName"
                style="@style/TextAppearance.FT.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/runDuration"
                style="@style/TextAppearance.FT.Number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/runDate"
            style="@style/TextAppearance.FT.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

        <!-- currency totals -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.FT.SmallLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/ft_label_gold" />

                <TextView
                    android:id="@+id/runGold"
                    style="@style/TextAppearance.FT.Number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:autoSizeMaxTextSize="14sp"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeTextType="uniform"
                    android:maxLines="1"
                    android:textColor="@color/ft_gold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.FT.SmallLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/ft_label_orns" />

                <TextView
                    android:id="@+id/runOrns"
                    style="@style/TextAppearance.FT.Number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:autoSizeMaxTextSize="14sp"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeTextType="uniform"
                    android:maxLines="1"
                    android:textColor="@color/ft_orns" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.FT.SmallLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/ft_label_exp" />

                <TextView
                    android:id="@+id/runExp"
                    style="@style/TextAppearance.FT.Number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:autoSizeMaxTextSize="14sp"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeTextType="uniform"
                    android:maxLines="1"
                    android:textColor="@color/ft_exp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.FT.SmallLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/ft_label_shards" />

                <TextView
                    android:id="@+id/runShards"
                    style="@style/TextAppearance.FT.Number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:autoSizeMaxTextSize="14sp"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeTextType="uniform"
                    android:maxLines="1"
                    android:textColor="@color/ft_shards" />
            </LinearLayout>
        </LinearLayout>

        <!-- proof chips (rows of max 4, built in code) -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/runProofs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="6dp" />

        <!-- expanded: per-minute rates + actions -->
        <LinearLayout
            android:id="@+id/runExpanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                style="@style/Widget.FT.Divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/rateGold"
                    style="@style/TextAppearance.FT.Muted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:textColor="@color/ft_accent" />

                <TextView
                    android:id="@+id/rateOrns"
                    style="@style/TextAppearance.FT.Muted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:textColor="@color/ft_accent" />

                <TextView
                    android:id="@+id/rateExp"
                    style="@style/TextAppearance.FT.Muted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:textColor="@color/ft_accent" />

                <TextView
                    android:id="@+id/rateShards"
                    style="@style/TextAppearance.FT.Muted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:textColor="@color/ft_accent" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/renameButton"
                    style="@style/TextAppearance.FT.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="20dp"
                    android:text="@string/ft_rename"
                    android:textColor="@color/ft_accent" />

                <TextView
                    android:id="@+id/deleteButton"
                    style="@style/TextAppearance.FT.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="20dp"
                    android:text="@string/ft_delete"
                    android:textColor="@color/ft_red_text" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
