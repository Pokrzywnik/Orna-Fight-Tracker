<?xml version="1.0" encoding="utf-8"?>
<!-- One cell of the 4-column stats grid: label, value, per-minute rate. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_nested"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/statLabel"
        style="@style/TextAppearance.FT.SmallLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statValue"
        style="@style/TextAppearance.FT.Number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:autoSizeMaxTextSize="15sp"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeTextType="uniform"
        android:maxLines="1"
        android:text="0" />

    <TextView
        android:id="@+id/statRate"
        style="@style/TextAppearance.FT.SmallLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:autoSizeMaxTextSize="11sp"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeTextType="uniform"
        android:maxLines="1"
        android:text="@string/ft_dash"
        android:textColor="@color/ft_accent" />
</LinearLayout>
