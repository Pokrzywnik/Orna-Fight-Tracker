<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <!-- ================= OCR ================= -->
        <TextView
            style="@style/TextAppearance.FT.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ft_sec_ocr"
            android:textColor="@color/ft_accent" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/ft_scan_interval">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/scanIntervalInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <CheckBox
            android:id="@+id/highQualityOcrCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/ft_high_quality_ocr" />

        <TextView
            style="@style/TextAppearance.FT.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/ft_high_quality_ocr_desc" />

        <CheckBox
            android:id="@+id/legacyOcrCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/ft_legacy_ocr" />

        <CheckBox
            android:id="@+id/experimentalOcrCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/ft_experimental_ocr" />

        <TextView
            style="@style/TextAppearance.FT.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/ft_experimental_ocr_desc" />

        <View
            style="@style/Widget.FT.Divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />

        <!-- ================= Tracking ================= -->
        <TextView
            style="@style/TextAppearance.FT.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ft_sec_tracking"
            android:textColor="@color/ft_accent" />

        <TextView
            style="@style/TextAppearance.FT.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ft_anguish_version" />

        <RadioGroup
            android:id="@+id/anguishGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioAnguish1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="1.0" />

            <RadioButton
                android:id="@+id/radioAnguish2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:minHeight="48dp"
                android:text="2.0" />
        </RadioGroup>

        <View
            style="@style/Widget.FT.Divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp" />

        <!-- ================= Notifications ================= -->
        <TextView
            style="@style/TextAppearance.FT.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ft_sec_notifications"
            android:textColor="@color/ft_accent" />

        <CheckBox
            android:id="@+id/materialNotifyCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/ft_notify_materials" />

        <TextView
            style="@style/TextAppearance.FT.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ft_notify_time"
            android:textStyle="bold" />

        <TimePicker
            android:id="@+id/materialTimePicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:timePickerMode="spinner" />

        <View
            style="@style/Widget.FT.Divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp" />

        <!-- ================= Appearance ================= -->
        <TextView
            style="@style/TextAppearance.FT.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ft_sec_appearance"
            android:textColor="@color/ft_accent" />

        <TextView
            style="@style/TextAppearance.FT.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ft_aura" />

        <Spinner
            android:id="@+id/auraSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <ImageView
            android:id="@+id/auraPreview"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_nested"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
		<TextView
			android:id="@+id/uiScaleLabel"
			style="@style/TextAppearance.FT.Body"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:text="@string/ft_ui_scale" />

		<com.google.android.material.slider.Slider
			android:id="@+id/uiScaleSlider"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:valueFrom="60"
			android:valueTo="140"
			android:stepSize="20"
			android:value="100" />

		<TextView
			style="@style/TextAppearance.FT.Muted"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/ft_ui_scale_desc" />
        <View
            style="@style/Widget.FT.Divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />

        <!-- ================= Item assessment ================= -->
        <TextView
            style="@style/TextAppearance.FT.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ft_sec_item_assessment"
            android:textColor="@color/ft_accent" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/ft_assess_db">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/assessDatabaseUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ft_assess_db_hint"
                android:inputType="textUri"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <View
            style="@style/Widget.FT.Divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />

        <!-- ================= Debug ================= -->
        <TextView
            style="@style/TextAppearance.FT.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ft_sec_debug"
            android:textColor="@color/ft_accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shareLogsButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:minHeight="48dp"
            android:text="@string/ft_share_logs"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
