<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trackerScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ft_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- ================= Header ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.FT.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ft_overline_tracker" />

                <TextView
                    style="@style/TextAppearance.FT.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ft_tracker_title" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/overlayToggle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ft_layers"
                    app:tint="@color/ft_text" />

                <TextView
                    style="@style/TextAppearance.FT.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/ft_overlay" />

                <View
                    android:id="@+id/overlayDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_dot_off" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/settingsButton"
                style="@style/Widget.FT.IconButton"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/ft_settings"
                android:src="@drawable/ic_ft_settings" />
        </LinearLayout>

        <!-- ================= Current run card ================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/runCard"
            style="@style/Widget.FT.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Collapsed row (about 64dp) -->
                <LinearLayout
                    android:id="@+id/runHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="6dp">

                    <!-- status + timer -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/statusDot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_dot_off" />

                            <TextView
                                android:id="@+id/statusText"
                                style="@style/TextAppearance.FT.Overline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/ft_idle" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/timerText"
                            style="@style/TextAppearance.FT.Timer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="22sp"
                            android:autoSizeMinTextSize="15sp"
                            android:autoSizeTextType="uniform"
                            android:maxLines="1"
                            android:text="@string/ft_zero_timer" />
                    </LinearLayout>

                    <!-- compact per-minute rates (running only) -->
                    <LinearLayout
                        android:id="@+id/compactRates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="2dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/compactGold"
                            style="@style/TextAppearance.FT.SmallLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/space_grotesk"
                            android:fontFeatureSettings="tnum"
                            android:maxLines="1"
                            android:textColor="@color/ft_gold"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/compactOrns"
                            style="@style/TextAppearance.FT.SmallLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/space_grotesk"
                            android:fontFeatureSettings="tnum"
                            android:maxLines="1"
                            android:textColor="@color/ft_orns"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/undoButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_button"
                        android:contentDescription="@string/ft_undo"
                        android:src="@drawable/ic_ft_undo"
                        android:visibility="gone"
                        app:tint="@color/ft_text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/stopButton"
                        style="@style/Widget.FT.Button.Stop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:minWidth="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/ft_stop"
                        android:visibility="gone"
                        app:icon="@drawable/ic_ft_stop"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/startButton"
                        style="@style/Widget.FT.Button.Start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:minWidth="0dp"
                        android:text="@string/ft_start"
                        app:icon="@drawable/ic_ft_play"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="18dp" />

                    <ImageView
                        android:id="@+id/runChevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:contentDescription="@string/ft_toggle_run_card"
                        android:src="@drawable/ic_ft_chevron_down"
                        app:tint="@color/ft_muted" />
                </LinearLayout>

                <!-- Expanded area -->
                <LinearLayout
                    android:id="@+id/runDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <View
                        style="@style/Widget.FT.Divider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/statGold"
                            layout="@layout/view_stat_cell"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/statOrns"
                            layout="@layout/view_stat_cell"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/statExp"
                            layout="@layout/view_stat_cell"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/statShards"
                            layout="@layout/view_stat_cell"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <!-- proof icons + counters (rows of max 4, built in code) -->
                    <LinearLayout
                        android:id="@+id/proofsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />

                    <!-- tracking summary row -> opens the Track dialog -->
                    <LinearLayout
                        android:id="@+id/trackingRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_nested"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ft_sliders"
                            app:tint="@color/ft_accent" />

                        <TextView
                            android:id="@+id/trackingSummaryText"
                            style="@style/TextAppearance.FT.Muted"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/ft_text" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:rotation="-90"
                            android:src="@drawable/ic_ft_chevron_down"
                            app:tint="@color/ft_muted" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================= Run history ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.FT.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ft_run_history" />

            <TextView
                style="@style/TextAppearance.FT.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ft_run_history_hint" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ft_search"
                app:tint="@color/ft_muted" />

            <EditText
                android:id="@+id/searchInput"
                style="@style/TextAppearance.FT.Body"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/ft_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColorHint="@color/ft_muted" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filterGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/Widget.FT.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/ft_chip_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAnguish"
                    style="@style/Widget.FT.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ft_chip_anguish" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTowers"
                    style="@style/Widget.FT.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ft_chip_towers" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCoral"
                    style="@style/Widget.FT.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ft_chip_coral" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGuard"
                    style="@style/Widget.FT.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ft_chip_guard" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRemembrance"
                    style="@style/Widget.FT.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ft_chip_remembrance" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/summaryText"
                style="@style/TextAppearance.FT.Muted"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/sortButton"
                style="@style/TextAppearance.FT.Label"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:textColor="@color/ft_accent" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/historyList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <TextView
            android:id="@+id/emptyText"
            style="@style/TextAppearance.FT.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="32dp"
            android:paddingBottom="32dp"
            android:text="@string/ft_no_runs"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
