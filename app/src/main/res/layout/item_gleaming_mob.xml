<?xml version="1.0" encoding="utf-8"?>
<!-- One mob tile. Fixed height + centred content = equal space above and below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mobCard"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="124dp"
    android:layout_margin="4dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <!-- 76dp frame: grey circle (undiscovered) or gleaming.webp aura (discovered) -->
    <FrameLayout
        android:id="@+id/mobFrame"
        android:layout_width="76dp"
        android:layout_height="76dp">

        <View
            android:id="@+id/mobCircle"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_sprite_well" />

        <!-- the AuraWebView is inserted here from code (index 1) -->

        <ImageView
            android:id="@+id/mobSprite"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <!-- WebView would swallow touches; this sits on top and forwards the tap -->
        <View
            android:id="@+id/mobTouch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true" />
    </FrameLayout>

    <TextView
        android:id="@+id/mobName"
        style="@style/TextAppearance.FT.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="2"
        android:textColor="@color/ft_text"
        android:textSize="11sp" />
</LinearLayout>