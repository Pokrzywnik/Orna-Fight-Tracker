<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ft_bg"
    android:orientation="vertical">

    <!-- Pages. Swiping is disabled in code; the bottom bar drives navigation. -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Sits below the pager (never over content). Bottom padding = nav-bar inset (set in code). -->
    <LinearLayout
        android:id="@+id/navContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ft_nav"
        android:orientation="vertical">

        <View
            style="@style/Widget.FT.Divider"
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            style="@style/Widget.FT.BottomNav"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            app:menu="@menu/bottom_nav" />
    </LinearLayout>
</LinearLayout>
