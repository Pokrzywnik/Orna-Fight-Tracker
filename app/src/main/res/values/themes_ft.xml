<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- App theme. In AndroidManifest set: android:theme="@style/Theme.FightTracker" -->
    <style name="Theme.FightTracker" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/ft_accent</item>
        <item name="colorOnPrimary">@color/ft_on_accent</item>
        <item name="colorSecondary">@color/ft_accent</item>
        <item name="colorOnSecondary">@color/ft_on_accent</item>
        <item name="colorSurface">@color/ft_card</item>
        <item name="colorOnSurface">@color/ft_text</item>
        <item name="colorSurfaceVariant">@color/ft_nested</item>
        <item name="colorOnSurfaceVariant">@color/ft_muted</item>
        <item name="colorOutline">@color/ft_line2</item>
        <item name="colorOutlineVariant">@color/ft_line</item>
        <item name="android:colorBackground">@color/ft_bg</item>
        <item name="android:windowBackground">@color/ft_bg</item>
        <item name="android:textColorPrimary">@color/ft_text</item>
        <item name="android:textColorSecondary">@color/ft_muted</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:statusBarColor">@color/ft_bg</item>
        <item name="android:navigationBarColor">@color/ft_nav</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FT.Dialog</item>
    </style>

    <style name="ThemeOverlay.FT.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/ft_card</item>
        <item name="colorSurfaceContainerHigh">@color/ft_card</item>
        <item name="colorOnSurface">@color/ft_text</item>
        <item name="colorPrimary">@color/ft_accent</item>
        <item name="android:textColorPrimary">@color/ft_text</item>
        <item name="android:textColorSecondary">@color/ft_muted</item>
    </style>

    <!-- Text appearances -->
    <style name="TextAppearance.FT.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/ft_muted</item>
    </style>

    <style name="TextAppearance.FT.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/ft_text</item>
    </style>

    <style name="TextAppearance.FT.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ft_text</item>
    </style>

    <style name="TextAppearance.FT.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ft_text</item>
    </style>

    <style name="TextAppearance.FT.Muted" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ft_muted</item>
    </style>

    <style name="TextAppearance.FT.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ft_text</item>
    </style>

    <style name="TextAppearance.FT.Number" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/ft_text</item>
    </style>

    <style name="TextAppearance.FT.Timer" parent="TextAppearance.FT.Number">
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextAppearance.FT.SmallLabel" parent="TextAppearance.FT.Muted">
        <item name="android:textSize">10sp</item>
    </style>

    <style name="TextAppearance.FT.Chip" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.FT.NavLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">10.5sp</item>
    </style>

    <!-- Bottom navigation -->
    <style name="Widget.FT.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/ft_nav</item>
        <item name="backgroundTint">@color/ft_nav</item>
        <item name="itemIconTint">@color/ft_nav_item</item>
        <item name="itemTextColor">@color/ft_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.FT.NavIndicator</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.FT.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.FT.NavLabel</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="android:minHeight">72dp</item>
        <item name="itemPaddingTop">6dp</item>
        <item name="itemPaddingBottom">6dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.FT.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/ft_accent_16</item>
        <item name="android:width">56dp</item>
        <item name="android:height">30dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.FT.Pill</item>
    </style>

    <style name="ShapeAppearance.FT.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">15dp</item>
    </style>

    <style name="ShapeAppearance.FT.Chip" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">17dp</item>
    </style>

    <!-- Chips -->
    <style name="Widget.FT.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:checkable">true</item>
        <item name="chipBackgroundColor">@color/ft_chip_bg</item>
        <item name="chipStrokeColor">@color/ft_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/ft_chip_text</item>
        <item name="android:textAppearance">@style/TextAppearance.FT.Chip</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="chipMinHeight">34dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.FT.Chip</item>
        <item name="rippleColor">@color/ft_accent_16</item>
    </style>

    <!-- Cards -->
    <style name="Widget.FT.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/ft_card</item>
        <item name="strokeColor">@color/ft_line</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="rippleColor">@color/ft_line2</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.FT.Button.Stop" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/ft_red</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="iconTint">#FFFFFF</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.FT.Button.Start" parent="Widget.FT.Button.Stop">
        <item name="backgroundTint">#2E7D32</item>
    </style>

    <style name="Widget.FT.IconButton" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/ft_text</item>
    </style>

    <style name="Widget.FT.SegButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/ft_seg_bg</item>
        <item name="android:textColor">@color/ft_seg_text</item>
        <item name="strokeColor">@color/ft_line</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Misc -->
    <style name="Widget.FT.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/ft_line</item>
    </style>
</resources>
